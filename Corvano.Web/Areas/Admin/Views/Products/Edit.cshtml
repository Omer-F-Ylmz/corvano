@model ProductFormViewModel
@{
    ViewData["Title"] = Model.Name;
    var sizes = new[] { "S", "M", "L", "XL", "XXL" };
}

<div class="page-head">
    <div>
        <a class="back-link" asp-area="Admin" asp-controller="Products" asp-action="Index">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span>Ürünler</span>
        </a>
        <h1 class="display-2">@Model.Name</h1>
        <p class="slug-line mono">/@Model.Slug</p>
    </div>
    <form method="post" asp-area="Admin" asp-controller="Products" asp-action="Delete">
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn btn--quiet btn--danger" type="submit">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            <span>Pasife al</span>
        </button>
    </form>
</div>

@if (Model.ErrorMessage is not null)
{
    <p class="form-alert" role="alert">
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        <span>@Model.ErrorMessage</span>
    </p>
}

<div class="edit-grid">
    <form class="form-card surface-elevated" method="post" asp-area="Admin" asp-controller="Products" asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <h2 class="heading-3">Ürün bilgisi</h2>
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
        <partial name="_ProductFields" model="Model" />

        <div class="form-actions">
            <button class="btn btn--primary" type="submit">
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Değişiklikleri kaydet</span>
            </button>
        </div>
    </form>

    <div class="side-stack">
        <section class="form-card surface-elevated" aria-labelledby="variants-title">
            <h2 class="heading-3" id="variants-title">Varyantlar</h2>

            @if (Model.Variants.Count == 0)
            {
                <p class="empty empty--inline">Bu ürünün bedeni yok. Aşağıdan ilk varyantı ekle.</p>
            }
            else
            {
                <ul class="variant-list">
                    @foreach (var variant in Model.Variants)
                    {
                        <li class="variant">
                            <div class="variant__id">
                                <span class="variant__size">@variant.Size</span>
                                <span class="variant__color">@variant.Color</span>
                                <span class="mono variant__sku">@variant.Sku</span>
                                @if (variant.PriceOverride is { } price)
                                {
                                    <span class="mono variant__price">@price.ToString("N0", new System.Globalization.CultureInfo("tr-TR")) ₺</span>
                                }
                            </div>
                            <form class="variant__stock" method="post" asp-area="Admin" asp-controller="Products" asp-action="UpdateStock">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="variantId" value="@variant.Id" />
                                <label class="sr-only" for="stock-@variant.Id">@variant.Sku stok adedi</label>
                                <input class="field__input field__input--tiny" id="stock-@variant.Id" name="stock" type="number" min="0" value="@variant.Stock" />
                                <button class="btn btn--quiet" type="submit">Kaydet</button>
                            </form>
                            <form method="post" asp-area="Admin" asp-controller="Products" asp-action="DeleteVariant">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="variantId" value="@variant.Id" />
                                <button class="btn btn--quiet btn--danger" type="submit">
                                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                    <span class="sr-only">@variant.Sku varyantını sil</span>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }

            <form class="sub-form" method="post" asp-area="Admin" asp-controller="Products" asp-action="AddVariant">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <div class="field-row field-row--tight">
                    <div class="field">
                        <label class="field__label" for="variant-size">Beden</label>
                        <select class="field__input" id="variant-size" name="Size">
                            @foreach (var size in sizes)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="variant-color">Renk</label>
                        <input class="field__input" id="variant-color" name="Color" autocomplete="off" />
                    </div>
                </div>
                <div class="field-row field-row--tight">
                    <div class="field">
                        <label class="field__label" for="variant-sku">Stok kodu</label>
                        <input class="field__input mono" id="variant-sku" name="Sku" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="variant-stock">Stok</label>
                        <input class="field__input" id="variant-stock" name="Stock" type="number" min="0" value="0" />
                    </div>
                </div>
                <button class="btn btn--primary btn--block" type="submit">
                    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    <span>Varyant ekle</span>
                </button>
            </form>
        </section>

        <section class="form-card surface-elevated" aria-labelledby="images-title">
            <h2 class="heading-3" id="images-title">Görseller</h2>

            @if (Model.Images.Count == 0)
            {
                <p class="empty empty--inline">Görsel yok. Barındırılan bir görselin adresini ekleyebilirsin.</p>
            }
            else
            {
                <ul class="image-list">
                    @foreach (var image in Model.Images)
                    {
                        <li class="image-row">
                            <img class="image-row__thumb" src="@image.Url" alt="@image.Alt" width="64" height="80" loading="lazy" />
                            <span class="image-row__alt">@image.Alt</span>
                            <form method="post" asp-area="Admin" asp-controller="Products" asp-action="DeleteImage">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="imageId" value="@image.Id" />
                                <button class="btn btn--quiet btn--danger" type="submit">
                                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                    <span class="sr-only">@image.Alt görselini sil</span>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }

            <form class="sub-form" method="post" asp-area="Admin" asp-controller="Products" asp-action="AddImage">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <div class="field">
                    <label class="field__label" for="image-url">Görsel adresi</label>
                    <input class="field__input" id="image-url" name="Url" type="url" placeholder="https://" />
                </div>
                <div class="field-row field-row--tight">
                    <div class="field">
                        <label class="field__label" for="image-alt">Alternatif metin</label>
                        <input class="field__input" id="image-alt" name="Alt" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="image-order">Sıra</label>
                        <input class="field__input" id="image-order" name="SortOrder" type="number" min="0" value="0" />
                    </div>
                </div>
                <button class="btn btn--primary btn--block" type="submit">
                    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    <span>Görsel ekle</span>
                </button>
            </form>
        </section>
    </div>
</div>
