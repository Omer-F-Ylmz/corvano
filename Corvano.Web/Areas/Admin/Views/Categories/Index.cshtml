@model CategoryListViewModel
@{
    ViewData["Title"] = "Kategoriler";
    var names = Model.Categories.ToDictionary(c => c.Id, c => c.Name);
}

<div class="page-head">
    <div>
        <p class="eyebrow">Katalog</p>
        <h1 class="display-2">Kategoriler</h1>
    </div>
    <a class="btn btn--primary" asp-area="Admin" asp-controller="Categories" asp-action="Create">
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        <span>Kategori ekle</span>
    </a>
</div>

@if (Model.ErrorMessage is not null)
{
    <p class="form-alert" role="alert">
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        <span>@Model.ErrorMessage</span>
    </p>
}

@if (Model.Categories.Count == 0)
{
    <p class="empty surface-elevated">Henüz kategori yok. İlk kategoriyi ekleyerek ürünlere yer aç.</p>
}
else
{
    <div class="table-wrap surface-elevated">
        <table class="data-table">
            <caption class="sr-only">Kategori listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Ad</th>
                    <th scope="col">Slug</th>
                    <th scope="col">Üst kategori</th>
                    <th scope="col" class="num">Sıra</th>
                    <th scope="col" class="num">Ürün</th>
                    <th scope="col">Durum</th>
                    <th scope="col"><span class="sr-only">İşlem</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    var count = Model.ProductCounts.TryGetValue(category.Id, out var c) ? c : 0;
                    <tr>
                        <th scope="row">@category.Name</th>
                        <td class="mono">@category.Slug</td>
                        <td>@(category.ParentId is { } parentId && names.TryGetValue(parentId, out var parentName) ? parentName : "—")</td>
                        <td class="num">@category.SortOrder</td>
                        <td class="num">@count</td>
                        <td><span class="pill @(category.IsActive ? "pill--live" : "pill--off")">@(category.IsActive ? "Yayında" : "Pasif")</span></td>
                        <td class="row-actions">
                            <a class="btn btn--quiet" asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id">Düzenle</a>
                            <form method="post" asp-area="Admin" asp-controller="Categories" asp-action="Delete">
                                <input type="hidden" name="id" value="@category.Id" />
                                <button class="btn btn--quiet btn--danger" type="submit">
                                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                    <span>Sil</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
