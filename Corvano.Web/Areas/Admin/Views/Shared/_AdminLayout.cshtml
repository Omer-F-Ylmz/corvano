@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var section = ViewContext.RouteData.Values["controller"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Corvano yönetim" : "Corvano yönetim")</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body surface-base">
    @if (signedIn)
    {
        <div class="admin-shell">
            <header class="admin-rail">
                <a class="admin-rail__brand" href="/" aria-label="Corvano vitrinine dön">
                    <span class="wordmark wordmark--rail">Corvano</span>
                    <span class="admin-rail__tag">Yönetim</span>
                </a>
                <nav class="admin-nav" aria-label="Yönetim bölümleri">
                    <a class="admin-nav__link @(section == "Products" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Products" asp-action="Index"
                       aria-current="@(section == "Products" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                        <span>Ürünler</span>
                    </a>
                    <a class="admin-nav__link @(section == "Categories" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Categories" asp-action="Index"
                       aria-current="@(section == "Categories" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                        <span>Kategoriler</span>
                    </a>
                </nav>
                <form class="admin-rail__exit" asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post">
                    <span class="admin-rail__who">@User.Identity!.Name</span>
                    <button class="btn btn--ghost" type="submit">
                        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                        <span>Çıkış</span>
                    </button>
                </form>
            </header>
            <main class="admin-main" id="main">
                @RenderBody()
            </main>
        </div>
        <footer class="admin-footer">
            <span>Corvano yönetim, @DateTime.UtcNow.Year</span>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index">Vitrini gör</a>
        </footer>
    }
    else
    {
        <header class="gate-header">
            <a class="wordmark" href="/" aria-label="Corvano ana sayfa">Corvano</a>
            <span class="site-header__meta">Yönetim</span>
        </header>
        <main class="admin-main admin-main--bare" id="main">
            @RenderBody()
        </main>
        <footer class="admin-footer">
            <span>Corvano yönetim, @DateTime.UtcNow.Year</span>
            <a class="footer-link" href="mailto:merhaba@corvano.com">merhaba@corvano.com</a>
        </footer>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
