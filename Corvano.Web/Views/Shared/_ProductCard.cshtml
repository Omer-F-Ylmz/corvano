@model ProductCardDto
@{
    var product = Model.Product;
    var url = $"/urun/{product.Slug}";
    // görsel kabı koyu yeşil: koyu zeminli fotoğraf önce
    var images = Storefront.ForTheme(Model.Images, dark: true);
    var primary = images.ElementAtOrDefault(0);
    var secondary = images.ElementAtOrDefault(1);
}
<li class="card" data-product-card>
    <a class="card__media" href="@url" tabindex="-1" aria-hidden="true">
        <partial name="_ProductVisual" model="@(new VisualModel(primary, Model.CategorySlug, product.Name))" />
        @if (secondary is not null)
        {
            <partial name="_ProductVisual" model="@(new VisualModel(secondary, Model.CategorySlug, product.Name, CssClass: "visual--alt"))" />
        }
    </a>
    <div class="card__body">
        <h3 class="card__name"><a class="card__link" href="@url">@product.Name</a></h3>
        <p class="card__price">@Storefront.Price(product.Price)</p>
        @if (Model.Variants.Count > 0)
        {
            <fieldset class="dots">
                <legend class="sr-only">@product.Name için beden ya da seçenek</legend>
                @foreach (var variant in Model.Variants)
                {
                    <label class="dot">
                        <input class="dot__input" type="radio" name="size-@product.Id" value="@variant.Sku" disabled="@(variant.Stock == 0)" />
                        <span class="dot__face">@variant.Size<span class="sr-only">@(variant.Stock == 0 ? ", tükendi" : "")</span></span>
                    </label>
                }
            </fieldset>
        }
        <button class="btn btn--cart" type="button" aria-disabled="true" aria-describedby="soon-@product.Id">
            Sepete ekle
            <span class="soon" id="soon-@product.Id">Yakında</span>
        </button>
    </div>
</li>
