@{
    var title = ViewData["Title"] is string t ? $"{t} · Corvano" : "Corvano — İstanbul'da dikilen erkek giyim";
    var description = ViewData["Description"] as string ?? "Corvano: İstanbul atölyesinde dikilen gömlek, pantolon, dış giyim, triko ve aksesuar.";
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var ogImage = ViewData["OgImage"] as string ?? "/img/products/yaka-cicegi-gri-1-dark.webp";
    var current = Context.Request.Path.Value ?? "/";
}
<!DOCTYPE html>
<html lang="tr" class="theme-light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@(origin + current)" />
    <meta property="og:site_name" content="Corvano" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@(origin + current)" />
    <meta property="og:image" content="@(ogImage.StartsWith('/') ? origin + ogImage : ogImage)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.classList.add('js');</script>
</head>
<body class="storefront">
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <header class="topbar">
        <div class="topbar__inner">
            <button class="icon-btn topbar__menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
                <span class="sr-only">Menü</span>
            </button>
            <a class="wordmark" href="/" aria-label="Corvano ana sayfa">Corvano</a>
            @await Component.InvokeAsync("SiteMenu")
            <div class="topbar__actions">
                <a class="icon-btn topbar__search" href="/koleksiyon/tumu" aria-label="Ara: tüm parçalar">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </a>
                <button class="icon-btn cart-btn" type="button" aria-disabled="true" aria-label="Sepet: 0 ürün, yakında">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    <span class="cart-btn__count" aria-hidden="true">0</span>
                </button>
            </div>
        </div>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p class="site-footer__line">Corvano · İstanbul atölyesi, @DateTime.UtcNow.Year</p>
        <a class="footer-link" href="mailto:merhaba@corvano.com">merhaba@corvano.com</a>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
