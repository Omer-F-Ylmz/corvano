@model CollectionPageDto
@{
    var heading = Model.ActiveSubcategory?.Name ?? Model.Category.Name;
    ViewData["Title"] = heading;
    ViewData["Description"] = $"Corvano {heading.ToLower(new System.Globalization.CultureInfo("tr-TR"))}: {Model.Products.Count} parça, beden seçenekleri ve fiyatlarıyla.";
    var ogImage = Storefront.ForTheme(Model.Products.SelectMany(p => p.Images).Where(Storefront.IsPhoto), dark: false).FirstOrDefault();
    if (ogImage is not null)
    {
        ViewData["OgImage"] = ogImage.Url;
    }

    var baseUrl = $"/koleksiyon/{Model.Category.Slug}";
    string SortUrl(string? key)
    {
        var query = new List<string>();
        if (Model.ActiveSubcategory is { } sub) query.Add($"alt={sub.Slug}");
        if (key is not null) query.Add($"sirala={key}");
        return query.Count == 0 ? baseUrl : $"{baseUrl}?{string.Join('&', query)}";
    }

    (string? Key, CollectionSort Sort, string Label)[] sorts =
    [
        (null, CollectionSort.Newest, "Yeni"),
        ("fiyat-artan", CollectionSort.PriceAscending, "Fiyat artan"),
        ("fiyat-azalan", CollectionSort.PriceDescending, "Fiyat azalan")
    ];
}

<section class="collection-head" aria-labelledby="collection-title">
    <div class="collection-head__title-block">
        <p class="kicker">Koleksiyon</p>
        <h1 id="collection-title" class="collection-head__title">@heading</h1>
    </div>
    <div class="collection-head__tools">
        <p class="collection-head__count">@Model.Products.Count parça</p>
        @if (Model.Products.Count > 1)
        {
            <nav class="sort" aria-label="Sıralama">
                <ul class="pills">
                    @foreach (var (key, sort, label) in sorts)
                    {
                        <li><a class="pill-link" href="@SortUrl(key)" aria-current="@(Model.Sort == sort ? "true" : null)">@label</a></li>
                    }
                </ul>
            </nav>
        }
    </div>
    @if (Model.Subcategories.Count > 0)
    {
        <nav class="collection-head__tabs" aria-label="@Model.Category.Name alt kategorileri">
            <ul class="pills">
                <li><a class="pill-link" href="@baseUrl" aria-current="@(Model.ActiveSubcategory is null ? "page" : null)">Tümü</a></li>
                @foreach (var sub in Model.Subcategories)
                {
                    <li><a class="pill-link" href="@baseUrl?alt=@sub.Slug" aria-current="@(Model.ActiveSubcategory?.Id == sub.Id ? "page" : null)">@sub.Name</a></li>
                }
            </ul>
        </nav>
    }
</section>

<section class="shelf shelf--collection" aria-labelledby="products-title">
    <h2 id="products-title" class="sr-only">Ürünler</h2>
    @if (Model.Products.Count == 0)
    {
        <div class="empty-card">
            <p class="empty-card__title">Bu koleksiyon hazırlanıyor</p>
            <p class="empty-card__text">Atölyedeki parçalar tamamlanınca burada olacak. O zamana kadar diğer parçalara göz atın.</p>
            <a class="text-link" href="/koleksiyon/tumu">Tüm parçalar</a>
        </div>
    }
    else
    {
        <ul class="product-grid">
            @foreach (var card in Model.Products)
            {
                <partial name="_ProductCard" model="card" />
            }
        </ul>
    }
</section>
