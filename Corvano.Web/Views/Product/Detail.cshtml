@model ProductViewModel
@using Corvano.Business.Utilities
@{
    var info = Model.Page;
    var product = info.Product;
    var fabric = Model.Fabric;
    // koyu sayfada koyu zeminli fotoğraf önce gelir
    var gallery = Storefront.ForTheme(info.Images, dark: true);
    var main = gallery.FirstOrDefault();
    // kumaş yakınlaştırması da koyu görsel kabında: koyu zeminli fotoğraf
    var detail = main;
    var sizeLabel = Model.IsAccessory ? "Seçenek" : "Beden";
    var hasPhotos = gallery.Any(Storefront.IsPhoto);
    ViewData["Title"] = product.Name;
    ViewData["Description"] = $"{product.Name}: {fabric.Fabric}. {Storefront.Price(product.Price)}. 2-4 iş gününde kargo, 14 gün iade.";
    ViewData["OgType"] = "product";
    if (hasPhotos)
    {
        ViewData["OgImage"] = gallery.First(Storefront.IsPhoto).Url;
    }
}

<nav class="crumbs" aria-label="Konum">
    <ol class="crumbs__list">
        @if (info.ParentCategory is { } parent)
        {
            <li><a class="crumbs__link" href="/koleksiyon/@parent.Slug">@parent.Name</a></li>
            <li><a class="crumbs__link" href="/koleksiyon/@parent.Slug?alt=@info.Category.Slug">@info.Category.Name</a></li>
        }
        else
        {
            <li><a class="crumbs__link" href="/koleksiyon/@info.Category.Slug">@info.Category.Name</a></li>
        }
    </ol>
</nav>

<div class="pdp">
    <section class="gallery @(hasPhotos && gallery.Count > 1 ? "gallery--thumbs" : null)" aria-label="Görseller" data-gallery>
        <div class="gallery__stage">
            <partial name="_ProductVisual" model="@(new VisualModel(main, Model.TopCategorySlug, product.Name, Large: true, Lazy: false, CssClass: "gallery__main"))" />
        </div>
        @if (hasPhotos && gallery.Count > 1)
        {
            <ul class="gallery__thumbs">
                @for (var i = 0; i < gallery.Count; i++)
                {
                    var image = gallery[i];
                    <li>
                        <button class="gallery__thumb" type="button" aria-pressed="@(i == 0 ? "true" : "false")" aria-label="Görsel @(i + 1): @image.Alt" data-gallery-thumb data-src="@image.Url" data-alt="@image.Alt">
                            <img src="@Storefront.Thumb(image.Url)" alt="" width="640" height="800" loading="lazy" />
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="buybox" aria-labelledby="piece-title">
        <p class="kicker">@info.Category.Name</p>
        <h1 id="piece-title" class="buybox__title">@product.Name</h1>
        <p class="buybox__price">@Storefront.Price(product.Price)</p>

        <fieldset class="dots dots--large">
            <legend class="field-label">@sizeLabel</legend>
            @foreach (var variant in info.Variants)
            {
                <label class="dot">
                    <input class="dot__input" type="radio" name="variant" value="@variant.Sku" disabled="@(variant.Stock == 0)" checked="@(variant.Size == Model.RecommendedSize && variant.Stock > 0)" />
                    <span class="dot__face">@variant.Size<span class="sr-only">@(variant.Stock == 0 ? ", tükendi" : $", {variant.Color}")</span></span>
                </label>
            }
        </fieldset>
        @if (!Model.IsAccessory)
        {
            <a class="text-link buybox__fit" href="#beden">Hangi beden bana olur?</a>
        }

        <div class="buybox__row">
            <label class="qty">
                <span class="field-label">Adet</span>
                <input class="qty__input" type="number" name="adet" min="1" max="10" value="1" inputmode="numeric" />
            </label>
            <button class="btn btn--cart btn--cart-wide" type="button" aria-disabled="true" aria-describedby="soon-detail">
                Sepete ekle
                <span class="soon" id="soon-detail">Yakında</span>
            </button>
        </div>

        <p class="buybox__shipping">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
            2-4 iş gününde kargo · 14 gün iade
        </p>
    </section>
</div>

<div class="stories">
    <section class="story" aria-labelledby="fabric-title" data-reveal>
        <h2 id="fabric-title" class="story__title">Kumaş</h2>
        <div class="story__body story__body--split">
            <div>
                <p class="story__lead">@fabric.Fabric</p>
                @if (fabric.Origin is not null)
                {
                    <p class="story__meta">Menşei: @fabric.Origin</p>
                }
            </div>
            @if (Storefront.IsPhoto(detail))
            {
                <figure class="zoom">
                    <img class="zoom__img" src="@Storefront.Thumb(detail!.Url)" alt="@detail.Alt" width="640" height="800" loading="lazy" />
                    <figcaption class="zoom__caption">Dokuyu görmek için üzerine gelin</figcaption>
                </figure>
            }
        </div>
    </section>

    <section class="story" aria-labelledby="wear-title" data-reveal>
        <h2 id="wear-title" class="story__title">Nasıl giyilir</h2>
        <div class="story__body">
            <p class="story__lead">@Model.HowToWear</p>
        </div>
    </section>

    @if (!Model.IsAccessory)
    {
        <section class="story" id="beden" aria-labelledby="size-title" data-reveal>
            <h2 id="size-title" class="story__title">Ölçü tablosu</h2>
            <div class="story__body story__body--split">
                <div class="table-scroll">
                    <table class="size-table">
                        <caption class="sr-only">Beden, boy ve kilo aralıkları</caption>
                        <thead>
                            <tr><th scope="col">Beden</th><th scope="col">Boy (cm)</th><th scope="col">Kilo (kg)</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in SizeAdvisor.Table)
                            {
                                <tr class="@(row.Size == Model.RecommendedSize ? "is-match" : null)">
                                    <th scope="row">@row.Size</th>
                                    <td>@row.MinHeightCm–@row.MaxHeightCm</td>
                                    <td>@row.MinWeightKg–@row.MaxWeightKg</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form class="fit" method="get" action="/urun/@product.Slug#beden">
                    <h3 class="fit__title">Hangi beden?</h3>
                    <div class="fit__row">
                        <label class="fit__field">
                            <span class="field-label">Boy (cm)</span>
                            <input class="fit__input" type="number" name="boy" min="140" max="220" value="@Model.HeightCm" inputmode="numeric" required />
                        </label>
                        <label class="fit__field">
                            <span class="field-label">Kilo (kg)</span>
                            <input class="fit__input" type="number" name="kilo" min="40" max="160" value="@Model.WeightKg" inputmode="numeric" required />
                        </label>
                        <button class="btn btn--ghost-light" type="submit">Bedeni bul</button>
                    </div>
                    @if (Model.HeightCm is not null && Model.WeightKg is not null)
                    {
                        <p class="fit__result" role="status">
                            @if (Model.RecommendedSize is { } size)
                            {
                                <text>Önerimiz: <strong>@size</strong>. İki beden arasındaysanız büyük olanı seçin.</text>
                            }
                            else
                            {
                                <text>Bu ölçüler tablonun dışında; atölyeye yazın, ölçünüze göre bakalım.</text>
                            }
                        </p>
                    }
                </form>
            </div>
        </section>
    }

    <section class="story" aria-labelledby="care-title" data-reveal>
        <h2 id="care-title" class="story__title">Bakım</h2>
        <div class="story__body">
            <p class="story__lead">@(fabric.Care ?? "Etiketteki talimatı izleyin.")</p>
        </div>
    </section>
</div>

@if (Model.Similar.Count > 0)
{
    <section class="shelf" aria-labelledby="similar-title">
        <div class="shelf__head">
            <h2 id="similar-title" class="shelf__title">Benzer parçalar</h2>
            <a class="text-link" href="/koleksiyon/@Model.TopCategorySlug">@((info.ParentCategory ?? info.Category).Name) koleksiyonu</a>
        </div>
        <ul class="product-grid">
            @foreach (var card in Model.Similar)
            {
                <partial name="_ProductCard" model="card" />
            }
        </ul>
    </section>
}
